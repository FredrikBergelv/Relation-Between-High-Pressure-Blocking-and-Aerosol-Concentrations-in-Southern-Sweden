@article{sommarLongtermExposureParticulate2021,
  title = {Long-Term Exposure to Particulate Air Pollution and Black Carbon in Relation to Natural and Cause-Specific Mortality: A Multicohort Study in {{Sweden}}},
  shorttitle = {Long-Term Exposure to Particulate Air Pollution and Black Carbon in Relation to Natural and Cause-Specific Mortality},
  author = {Sommar, Johan Nilsson and Andersson, Eva M. and Andersson, Niklas and Sallsten, Gerd and Stockfelt, Leonard and Ljungman, Petter LS and Segersson, David and Eneroth, Kristina and Gidhagen, Lars and Molnar, Peter and Wennberg, Patrik and Rosengren, Annika and Rizzuto, Debora and Leander, Karin and Lager, Anton and Magnusson, Patrik KE and Johansson, Christer and Barregard, Lars and Bellander, Tom and Pershagen, G{\"o}ran and Forsberg, Bertil},
  year = 2021,
  month = sep,
  journal = {BMJ Open},
  volume = {11},
  number = {9},
  pages = {e046040},
  publisher = {British Medical Journal Publishing Group},
  issn = {2044-6055, 2044-6055},
  doi = {10.1136/bmjopen-2020-046040},
  urldate = {2025-10-24},
  abstract = {Objectives To estimate concentration--response relationships for particulate matter (PM) and black carbon (BC) in relation to mortality in cohorts from three Swedish cities with comparatively low pollutant levels. Setting Cohorts from Gothenburg, Stockholm and Ume\aa, Sweden. Design High-resolution dispersion models were used to estimate annual mean concentrations of PM with aerodynamic diameter {$\leq$}10 \textmu m (PM10) and {$\leq$}2.5 \textmu m (PM2.5), and BC, at individual addresses during each year of follow-up, 1990--2011. Moving averages were calculated for the time windows 1--5 years (lag1--5) and 6--10 years (lag6--10) preceding the outcome. Cause-specific mortality data were obtained from the national cause of death registry. Cohort-specific HRs were estimated using Cox regression models and then meta-analysed including a random effect of cohort. Participants During the study period, 7 340 cases of natural mortality, 2 755 cases of cardiovascular disease (CVD) mortality and 817 cases of respiratory and lung cancer mortality were observed among in total 68 679 individuals and 689 813 person-years of follow-up. Results Both PM10 (range: 6.3--41.9 \textmu g/m3) and BC (range: 0.2--6.8 \textmu g/m3) were associated with natural mortality showing 17\% (95\% CI 6\% to 31\%) and 9\% (95\% CI 0\% to 18\%) increased risks per 10 \textmu g/m3 and 1 \textmu g/m3 of lag1-5 exposure, respectively. For PM2.5 (range: 4.0--22.4 \textmu g/m3), the estimated increase was 13\% per 5 \textmu g/m3, but less precise (95\% CI -9\% to 40\%). Estimates for CVD mortality appeared higher for both PM10 and PM2.5. No association was observed with respiratory mortality. Conclusion The results support an effect of long-term air pollution on natural mortality and mortality in CVD with high relative risks also at low exposure levels. These findings are relevant for future decisions concerning air quality policies.},
