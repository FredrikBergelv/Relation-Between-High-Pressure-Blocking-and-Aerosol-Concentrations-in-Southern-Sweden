  langid = {english},
  pmid = {34497075},
  keywords = {cardiac epidemiology,epidemiology,public health},
  file = {/home/fredrik/Zotero/storage/JRJQ4RKA/Sommar et al. - 2021 - Long-term exposure to particulate air pollution and black carbon in relation to natural and cause-sp.pdf}
}

