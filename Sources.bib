@article{senEstimatesRegressionCoefficient1968,
  title = {Estimates of the {{Regression Coefficient Based}} on {{Kendall}}'s {{Tau}}},
  author = {Sen, Pranab Kumar},
  year = {1968},
  month = dec,
  journal = {Journal of the American Statistical Association},
  volume = {63},
  number = {324},
  pages = {1379--1389},
  issn = {0162-1459},
  doi = {10.1080/01621459.1968.10480934},
  urldate = {2025-07-24},
  abstract = {The least squares estimator of a regression coefficient {$\beta$} is vulnerable to gross errors and the associated confidence interval is, in addition, sensitive to non-normality of the parent distribution. In this paper, a simple and robust (point as well as interval) estimator of {$\beta$} based on Kendall's [6] rank correlation tau is studied. The point estimator is the median of the set of slopes (Yj - Yi )/(tj-ti ) joining pairs of points with ti {$\neq$} ti , and is unbiased. The confidence interval is also determined by two order statistics of this set of slopes. Various properties of these estimators are studied and compared with those of the least squares and some other nonparametric estimators.}
}

